{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.varnix.infected": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "death": "query.health <= 0"
            },
            {
              "attack": "query.attack_time > 0.0"
            },
            {
              "run": "query.is_moving && query.modified_move_speed > 0.25"
            },
            {
              "walk": "query.is_moving"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "death": "query.health <= 0"
            },
            {
              "attack": "query.attack_time > 0.0"
            },
            {
              "run": "query.modified_move_speed > 0.25"
            },
            {
              "default": "!query.is_moving"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "death": "query.health <= 0"
            },
            {
              "attack": "query.attack_time > 0.0"
            },
            {
              "walk": "query.modified_move_speed <= 0.25 && query.is_moving"
            },
            {
              "default": "!query.is_moving"
            }
          ]
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "death": "query.health <= 0"
            },
            {
              "default": "query.attack_time <= 0.0"
            }
          ]
        },
        "death": {
          "animations": [
            "death"
          ]
        }
      }
    }
  }
}
